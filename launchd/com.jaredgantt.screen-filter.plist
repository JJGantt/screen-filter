<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jaredgantt.screen-filter</string>
  <key>ProgramArguments</key><array><string>@BIN@</string><string>daemon</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/screen-filter.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/screen-filter.log</string>
</dict>
</plist>
